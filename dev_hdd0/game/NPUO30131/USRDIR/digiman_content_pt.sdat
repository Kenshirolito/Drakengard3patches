									"text" : "{{P::style_key:page_subheader;&&Um Jogador}}{{P::style_key:page_normal;&& }}{{P::style_key:page_bold;&&Menus}}{{P::style_key:page_normal;&& }}{{ELL::style_key:page_normal;&&Navegar...{▲}/{▼}/{◀}/{▶} }}{{ELL::style_key:page_normal;&&Selecionar item de menu...{S} }}{{ELL::style_key:page_normal;&&Tela anterior...{A} }}{{P::style_key:page_normal;&& }}{{P::style_key:page_bold;&&Jogabilidade}}{{P::style_key:page_normal;&& }}{{ELL::style_key:page_normal;&&Mover/agachar...controle esquerdo }}{{ELL::style_key:page_normal;&&Pesquisar (apenas para o modo um jogador)...controle direito }}{{ELL::style_key:page_normal;&&Selecionar Cabeça...{◀}/{▶} }}{{ELL::style_key:page_normal;&&Ação da Cabeça...{▼} }}{{ELL::style_key:page_normal;&&Saltar...{S} }}{{ELL::style_key:page_normal;&&Cortar (requer o Calibrus)...{F} }}{{ELL::style_key:page_normal;&&Bomba Ninja (requer os poderes Ninja)...{A} }}{{ELL::style_key:page_normal;&&Garra-gancho (requer os poderes de Pirata)...{D} }}{{ELL::style_key:page_normal;&&Guardar (requer os poderes de Cavaleiro)...{Q} (segurar) }}{{ELL::style_key:page_normal;&&Ataque Estrondoso com Corpo (requer os poderes do wrestler)...{E} }}{{ELL::style_key:page_normal;&&Rolar...{W} }}{{ELL::style_key:page_normal;&&Investigar (apenas para o modo um jogador)...{R} }}{{ELL::style_key:page_normal;&&Pausa...{w} }}",
